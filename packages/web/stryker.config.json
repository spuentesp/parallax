{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false
  },
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/test/**",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "reporters": [
    "clear-text",
    "json",
    "progress"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 0
  },
  "concurrency": 1,
  "timeoutMS": 20000,
  "incremental": false
}
