# Copy to deploy/.env and fill in. NEVER commit the real file.

# DNS name that points at this host (Caddy gets the certificate for it).
DOMAIN=parallax.example.com

# Access tokens: generate with `node deploy/gen-tokens.mjs` and paste the line it prints.
PARALLAX_TOKENS=

# Nebius Token Factory: this is what makes the investigator (Nemotron) run.
NEBIUS_TOKEN=
# NEMOTRON_PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEMOTRON_WORKER_MODEL=nvidia/Nemotron-3_5-Lightning

# Lain 0.13.0, reachable from the container (host.docker.internal = the VM itself).
LAIN_URL=http://host.docker.internal:9999/mcp

# Protect your Token Factory credits: questions per access token per hour (0 = no limit).
QUERY_RATE_LIMIT_PER_HOUR=40
