# Copy to deploy/.env and fill in. NEVER commit the real file.

# DNS name pointing at this host (Caddy gets the Let's Encrypt certificate automatically).
DOMAIN=parallax.example.com

# Access tokens: generate with `node deploy/gen-tokens.mjs https://YOUR.DOMAIN` and paste the line it prints.
# Includes:
#   1. Looking token (read-only viewer access)
#   2. Judge token (testing access for hackathon judges)
#   3. Admin token (maintainer access)
PARALLAX_TOKENS=

# Nebius Token Factory: runs the Nemotron investigator models.
NEBIUS_TOKEN=
# NEMOTRON_PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEMOTRON_WORKER_MODEL=nvidia/Nemotron-3_5-Lightning

# Lain analysis engine, reachable from the container (host.docker.internal = the VM host).
LAIN_URL=http://host.docker.internal:9999/mcp

# Protect your Token Factory credits: questions per access token per hour (0 = no limit).
QUERY_RATE_LIMIT_PER_HOUR=40
