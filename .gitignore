# Env / secrets
.env
.env.local
.env.*.local

# Lain runtime state (workspace-local, never source)
.lain/
.parallax/

# Test data
data/

# Build artifacts
node_modules/
dist/
build/
# Test coverage reports only. A bare `coverage/` also matched the source directory
# packages/api/src/coverage, which therefore was never committed.
/coverage/
packages/*/coverage/
**/*.tsbuildinfo
.DS_Store

# Test repos (cloned for LAIN integration testing, not source)
test-repos/

# Local git worktrees
.worktrees/

# Mutation testing artifacts
packages/*/reports/
packages/*/.stryker-tmp/

# Temp scratch (TMPDIR for local test runs)
.tmp/
docs/codegeist/video/out/
