# Auth (required). JSON array of {token, orgId, scopes: ["read","write","publish"]}
PARALLAX_TOKENS=[{"token":"px_dev_change_me","orgId":"org_demo","scopes":["read","write"]}]

# Port for the api
PORT=8080

# Path to the SQLite file (the api will create the parent dir on boot)
DATABASE_PATH=./data/parallax.db

# Lain adapter: "mock" (default) or "real". Use Lain 0.11.0 for GraphQL bindings.
LAIN_ADAPTER=mock
LAIN_URL=http://localhost:9999/mcp

# MCP transport: "stdio" (dev) or "http-sse" (production / dev with /mcp route)
PARALLAX_MCP_TRANSPORT=http-sse

# Nebius Token Factory credential: the only model credential. Used by the
# investigator (G3) and the assessment explanations; read in one place
# (modelEnv in packages/api/src/config.ts). Create a key at
# https://tokenfactory.nebius.com and paste the bearer value here.
# Without it the structural analysis still works; explanation_status reports
# failed:no_model_configured (never a silent skip).
NEBIUS_TOKEN=

# Optional LangSmith tracing of model calls (the SDK's own variable name).
# LANGSMITH_API_KEY=

# Investigator endpoint and models (configurable: the effective model is an
# experimental condition, recorded in every explanation payload).
NEMOTRON_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEMOTRON_PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b
# Live release checks also pass with nvidia/nemotron-3-super-120b-a12b as worker.
# With the relay on, the worker only READS: the cheap model is the right one
# there, and the strong one plans and writes (that is the measured pairing:
# docs/agent-spend.md).
NEMOTRON_WORKER_MODEL=nvidia/Nemotron-3_5-Lightning

# Research budget per query (design §6): tool calls and model wall-clock.
# After ~60% of the tool budget the model is asked to wrap up; on the last read the
# next call is forced to be the answer, so a question always ends in an answer.
# One tool is capped per question (search_code 4, others up to 6) and an identical
# repeated call is refused. Measured: docs/agent-spend.md.
INVESTIGATOR_MAX_TOOL_CALLS=10
INVESTIGATOR_MAX_MODEL_MS=180000
# Tokens of reply per model turn (default 4096; 2048 cut long answers off).
# INVESTIGATOR_MAX_TOKENS=4096
# Model's hidden reasoning in the investigation: on | off | default (the server's).
# Measured: for the tool-calling loop OFF made it wander more, so leave it unset.
# (The loose-ends classifier always runs with reasoning OFF: its replies are short.)
# INVESTIGATOR_THINKING=default

# The relay: the strong model (planner) plans and writes, the fast one (worker)
# reads. Two extra model calls per question: it wins on quality (10/12 vs 6/12 on
# Saleor) and costs tokens (188k vs 47k of input). OFF goes back to one model
# doing everything: docs/agent-spend.md.
# INVESTIGATOR_HANDOFF=off

# Web search (Tavily) for technical / orientation questions: official docs first,
# explained next to what the engine found in the repos. Without a key the web_search
# tool is not offered to the model at all.
# TAVILY_TOKEN=tvly-...

# Path to the built web bundle. Run `pnpm --filter @parallax/web build` first.
WEB_BUNDLE_PATH=./packages/web/dist
