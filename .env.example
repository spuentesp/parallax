# Auth (required). JSON array of {token, orgId, scopes: ["read","write","publish"]}
PARALLAX_TOKENS=[{"token":"px_dev_change_me","orgId":"org_demo","scopes":["read","write"]}]

# Port for the api
PORT=8080

# Path to the SQLite file (the api will create the parent dir on boot)
DATABASE_PATH=./data/parallax.db

# Lain adapter: "mock" (default) or "real". Use Lain 0.11.0 for GraphQL bindings.
LAIN_ADAPTER=mock
LAIN_URL=http://localhost:9999/mcp

# MCP transport: "stdio" (dev) or "http-sse" (production / dev with /mcp route)
PARALLAX_MCP_TRANSPORT=http-sse

# Nebius Token Factory credential: the only model credential. Used by the
# investigator (G3) and the assessment explanations; read in one place
# (modelEnv in packages/api/src/config.ts). Create a key at
# https://tokenfactory.nebius.com and paste the bearer value here.
# Without it the structural analysis still works; explanation_status reports
# failed:no_model_configured (never a silent skip).
NEBIUS_TOKEN=

# Optional LangSmith tracing of model calls (the SDK's own variable name).
# LANGSMITH_API_KEY=

# Investigator endpoint and models (configurable: the effective model is an
# experimental condition, recorded in every explanation payload).
NEMOTRON_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEMOTRON_PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b
# Live release checks also pass with nvidia/nemotron-3-super-120b-a12b as worker.
NEMOTRON_WORKER_MODEL=nvidia/Nemotron-3_5-Lightning

# Research budget per query (design §6): tool calls and model wall-clock.
INVESTIGATOR_MAX_TOOL_CALLS=16
INVESTIGATOR_MAX_MODEL_MS=120000

# Path to the built web bundle. Run `pnpm --filter @parallax/web build` first.
WEB_BUNDLE_PATH=./packages/web/dist
